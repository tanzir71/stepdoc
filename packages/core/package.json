    "test:browser": "node tests/redaction-worker.verify.mjs && node tests/canvas-worker.verify.mjs"
  },
  "dependencies": {
    "@stepdoc/schema": "workspace:*",
    "ibantools": "4.5.4",
    "libphonenumber-js": "1.13.17",
    "re2js": "2.10.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "24.3.0",
    "jsdom": "26.1.0",
    "playwright": "1.55.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
