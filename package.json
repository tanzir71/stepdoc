{
  "name": "stepdoc",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanzir71/stepdoc.git"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @stepdoc/app dev",
    "dev:legacy": "pnpm --filter @stepdoc/web dev",
    "build": "pnpm -r build",
    "build:php": "node servers/php/scripts/build.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:a11y": "pnpm --filter @stepdoc/app test:a11y && pnpm --filter @stepdoc/contract exec vitest run php.installer.test.ts",
    "test:contract": "node tests/contract/run.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm website:verify && pnpm website:browser && pnpm website:lighthouse",
    "format": "prettier --write .",
    "website:build": "node scripts/generate-website.mjs",
    "website:guide": "pnpm --filter @stepdoc/core exec node scripts/website-demo.mjs",
    "website:verify": "node scripts/verify-website.mjs && pnpm --filter @stepdoc/core exec node scripts/website-demo.mjs --check",
    "website:lighthouse": "pnpm --filter @stepdoc/web exec node scripts/verify-public-website.mjs --lighthouse",
    "website:browser": "pnpm --filter @stepdoc/web exec node scripts/verify-public-website.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
