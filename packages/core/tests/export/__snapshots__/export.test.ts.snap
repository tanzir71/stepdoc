    } catch {
      // Native call logs can contain runtime input. Never attach the original error.
      throw new Error("Step 3 failed or is not replayable");
    }
  });
  await test.step("4. Select Team", async () => {
    try {
      throw new Error("Step 4 is not replayable: target locator is missing");
    } catch {
      // Native call logs can contain runtime input. Never attach the original error.
      throw new Error("Step 4 failed or is not replayable");
    }
  });
  await test.step("5. Press Enter", async () => {
    try {
      await page.keyboard.press("Enter");
    } catch {
      // Native call logs can contain runtime input. Never attach the original error.
