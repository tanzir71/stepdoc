{
  "name": "@stepdoc/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./describe-step": "./src/describe-step.ts",
    "./locators": "./src/locators.ts",
    "./selector": "./src/selector.ts",
    "./redaction": "./src/redaction/index.ts",
    "./canvas": "./src/canvas/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
