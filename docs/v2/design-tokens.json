{
  "$description": "StepDoc v2 design tokens, exported from Figma variables (collections Color [Light default, Dark], Space, Radius) and text styles. CSS custom property = --sd-<name with / replaced by ->. Light is :root; dark is [data-theme=dark] and prefers-color-scheme: dark when the user picks 'System'.",
  "figma": "https://www.figma.com/design/lTCFRrrKJb415s0nSxKE3B/StepDoc---Scribe?node-id=13-665",
  "rules": [
    "Screens use semantic tokens only; no raw hex in components.",
    "No glow effects anywhere. Elevation = surface tint; shadows only for floating layers (menus, dialogs, toolbars): 0 8px 24px rgba(0,0,0,.10) max.",
    "No italics. Emphasis by weight or colour.",
    "No strokes on navigation bars. Borders only for focus, selection and dashed drop zones.",
    "One accent (ember) for primary action, click marker, focus ring. agent/* only on agent-facing affordances.",
    "Text on accent/solid uses text/on-accent (dark), never white.",
    "Focus ring: 1px accent/solid + 2px offset, visible on every interactive element."
  ],
