"import { test, expect, type Locator, type Page } from '@playwright/test';

// Runtime variables: STEPDOC_BILLING_EMAIL, STEPDOC_SEATS, STEPDOC_PLAN.
// Run with a local authenticated browser context when preconditions require one.
test.use({ trace: 'off', screenshot: 'off', video: 'off' });
// Close pages before fixture teardown so failure context snapshots cannot retain input.
test.afterEach(async ({ context }) => {
  await Promise.all(context.pages().map((page) => page.close()));
});

function readVariable(name: string): string {
  const value = process.env[name];
  if (value === undefined) throw new Error('Required replay variable is missing');
  return value;
}

function matchesUrl(input: URL, expected: string): boolean {
  const url = new URL(input.href);
  url.username = url.password = url.search = url.hash = '';
  if (expected.startsWith('/')) return url.pathname.startsWith(expected);
  if (/^https?:\\/\\//i.test(expected)) return url.href === expected;
  return new RegExp(expected).test(url.href);
}

async function resolveTarget(candidates: Array<() => Locator>): Promise<Locator> {
  let target: Locator | undefined;
  await expect(async () => {
    for (const create of candidates) {
      try {
        const candidate = create();
        if (await candidate.count() === 1 && await candidate.isVisible()) {
          target = candidate;
          return;
        }
      } catch { /* Invalid/stale selectors must not suppress usable fallbacks. */ }
    }
    throw new Error('No unique visible target');
  }).toPass({ timeout: 5000 });
  if (!target) throw new Error('No unique visible target');
  return target;
}

test("Change the workspace plan", async ({ page }) => {

  try { await page.goto("https://example.com/settings"); } catch { throw new Error('Replay initialization failed'); }
  await test.step("1. Click Change plan", async () => {
    try {
      const target = await resolveTarget([() => page.frameLocator("iframe#settings").locator("plan-card").getByRole("button" as Parameters<Page['getByRole']>[0], { name: "Change plan", exact: true }), () => page.frameLocator("iframe#settings").locator("plan-card").getByTestId("change-plan"), () => page.frameLocator("iframe#settings").locator("plan-card").getByLabel("Change plan", { exact: true }), () => page.frameLocator("iframe#settings").locator("plan-card").getByPlaceholder("Search plans", { exact: true }), () => page.frameLocator("iframe#settings").locator("plan-card").getByAltText("Plan details", { exact: true }), () => page.frameLocator("iframe#settings").locator("plan-card").getByTitle("Change plan", { exact: true }), () => page.frameLocator("iframe#settings").locator("plan-card").locator("#change-plan"), () => page.frameLocator("iframe#settings").locator("plan-card").locator("xpath=//button[@id='change-plan']"), () => page.frameLocator("iframe#settings").locator("plan-card").getByText("Change plan", { exact: true })]);
      await target.click();
      await expect(page).toHaveURL((url) => matchesUrl(url, "/settings"));
      await expect(page.frameLocator("iframe#settings").locator("plan-card").getByRole("dialog" as Parameters<Page['getByRole']>[0], { name: "Choose plan", exact: true })).toBeVisible();
      await expect(page.frameLocator("iframe#settings").locator("plan-card").getByRole("status" as Parameters<Page['getByRole']>[0], { name: "Loading", exact: true })).toBeHidden();
      await expect(page.frameLocator("iframe#settings").locator("plan-card").getByRole("heading" as Parameters<Page['getByRole']>[0]).filter({ hasText: "Choose a plan" })).toBeVisible();
    } catch {
      // Native call logs can contain runtime input. Never attach the original error.
      throw new Error("Step 1 failed or is not replayable");
    }
  });
  await test.step("2. Fill in the Billing contact field", async () => {
    try {
      const target = await resolveTarget([() => page.getByRole("textbox" as Parameters<Page['getByRole']>[0], { name: "Billing contact", exact: true })]);
      await target.fill(readVariable("STEPDOC_BILLING_EMAIL"));
    } catch {
      // Native call logs can contain runtime input. Never attach the original error.
